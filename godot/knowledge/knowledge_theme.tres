[gd_resource type="Theme" load_steps=5 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBox_panel"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 8.0
bg_color = Color(0.09, 0.11, 0.15, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.18)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 8

[sub_resource type="StyleBoxFlat" id="StyleBox_locked"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 8.0
bg_color = Color(0.09, 0.11, 0.15, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.95, 0.85, 0.55, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 8

[sub_resource type="StyleBoxFlat" id="StyleBox_lock_back"]
content_margin_top = 1.0
content_margin_bottom = 1.0
bg_color = Color(1, 1, 1, 0.08)

[sub_resource type="StyleBoxFlat" id="StyleBox_lock_fill"]
content_margin_top = 1.0
content_margin_bottom = 1.0
bg_color = Color(0.95, 0.85, 0.55, 1)

[resource]
KnowledgeTooltip/base_type = &"PanelContainer"
KnowledgeTooltip/styles/panel = SubResource("StyleBox_panel")
KnowledgeTooltipLocked/base_type = &"KnowledgeTooltip"
KnowledgeTooltipLocked/styles/panel = SubResource("StyleBox_locked")
KnowledgeTooltipLines/base_type = &"VBoxContainer"
KnowledgeTooltipLines/constants/separation = 6
KnowledgeTooltipTitle/base_type = &"Label"
KnowledgeTooltipTitle/colors/font_color = Color(0.95, 0.85, 0.55, 1)
KnowledgeTooltipTitle/font_sizes/font_size = 18
KnowledgeTooltipBody/base_type = &"RichTextLabel"
KnowledgeTooltipLock/base_type = &"ProgressBar"
KnowledgeTooltipLock/styles/background = SubResource("StyleBox_lock_back")
KnowledgeTooltipLock/styles/fill = SubResource("StyleBox_lock_fill")
