[gd_resource type="KnowledgeConcept" format=3]

[resource]
id = &"map_mode"
title = "Map Mode"
body = "One way of colouring the [concept:location|locations] of the [concept:map], such as by [concept:terrain] or by [concept:province]. One is shown at a time.

The map mode also decides what picking the map chooses as the [concept:selection]."
