; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Malazan"
config/description="A 4x grand strategy game inspired by The Malazan Books of the Fallen."
config/tags=PackedStringArray("4x", "strategy")
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="uid://dihioy3ar2vyo"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/knowledge_editor/plugin.cfg", "res://addons/map_editor/plugin.cfg")

[game]

knowledge/tooltip_theme="res://knowledge/knowledge_theme.tres"
